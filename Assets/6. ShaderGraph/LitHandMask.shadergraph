            "m_Id": "cc275d0ad4c347a0a873ce058b92249e"
        },
        {
            "m_Id": "2a21d703d6f64d17820f9726a4e427e0"
        },
        {
            "m_Id": "870c1443c0ae403f88080e75f663749a"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "StereoHandMask",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 toSurface = PositionWS - CenterEyeWS;\nfloat surfaceDepth = length(toSurface);\nfloat3 ray = toSurface / max(surfaceDepth, 0.00001);\n\nbool masked = false;\n\n[unroll]\nfor (int i = 0; i < 2; i++)\n{\n    float4 hand = (i == 0) ? LeftHandWS : RightHandWS;\n    float3 toHand = hand.xyz - CenterEyeWS;\n\n    float handDepth = dot(toHand, ray);\n    float3 offset = toHand - ray * handDepth;\n\n    bool inside = dot(offset, offset) < Radius * Radius;\n    bool inFront = handDepth > 0.0\n        && handDepth + DepthBias < surfaceDepth;\n\n    masked = masked || (hand.w > 0.5 && inside && inFront);\n}\n\nAlpha = masked ? 0.0 : 1.0;"
}

