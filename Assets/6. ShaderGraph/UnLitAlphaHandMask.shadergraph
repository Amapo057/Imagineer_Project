{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "85771f56e90148949b31828a0154da99",
    "m_Group": {
        "m_Id": "3019ebf25e4f4e689f9658cce39565fe"
    },
    "m_Name": "StereoHandMask (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -467.0000305175781,
            "y": 559.0000610351563,
            "width": 252.00001525878907,
            "height": 213.99993896484376
        }
    },
    "m_Slots": [
        {
            "m_Id": "961d3977327149f2946b05406a8975df"
        },
        {
            "m_Id": "59df6c29ed4b4a62ba398823d1c214d2"
        },
        {
            "m_Id": "4ca7f384629740a7aae5f4e79d1d3e82"
        },
        {
            "m_Id": "051298b5764a40e997bd106cfafb025d"
        },
        {
            "m_Id": "b265b3f0c2a3487fb7947da151eea0a3"
        },
        {
            "m_Id": "35e25c93787743509b6f3d4171776831"
        },
        {
            "m_Id": "b2dc6a4b296b4938ac2e894c38fe9a02"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "StereoHandMask",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 toSurface = PositionWS - CenterEyeWS;\nfloat surfaceDepth = length(toSurface);\nfloat3 ray = toSurface / max(surfaceDepth, 0.00001);\n\nbool masked = false;\n\n[unroll]\nfor (int i = 0; i < 2; i++)\n{\n    float4 hand = (i == 0) ? LeftHandWS : RightHandWS;\n    float3 toHand = hand.xyz - CenterEyeWS;\n\n    float handDepth = dot(toHand, ray);\n    float3 offset = toHand - ray * handDepth;\n\n    bool inside = dot(offset, offset) < Radius * Radius;\n    bool inFront = handDepth > 0.0\n        && handDepth + DepthBias < surfaceDepth;\n\n    masked = masked || (hand.w > 0.5 && inside && inFront);\n}\n\nAlpha = masked ? 0.0 : 1.0;"
}

